# ---------------------------------------------------------------------------
# ZYREX STORE — environment variables
# Copy to .env for local development. NEVER commit a real .env file.
# In AppJet, add these in Settings -> Environment variables.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Secret used to sign customer/admin session tokens (JWT).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Public site URL, used for links and Razorpay callbacks.
PUBLIC_SITE_URL=http://localhost:3000

# Where the JSON data store lives (defaults to ./data/db.json).
DATA_DIR=./data

# --- Supabase (PostgreSQL + Auth + Storage) -------------------------------
# Server-only. The service-role key must never reach the browser bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (start in TEST mode) ---------------------------------------
# Test keys are prefixed with rzp_test_. Secret stays on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key exposed to the browser checkout (safe to publish).
VITE_RAZORPAY_KEY_ID=

# --- Payments / orders ----------------------------------------------------
# Cash on Delivery can be disabled from the admin dashboard settings.
ENABLE_COD=true
SHIPPING_FLAT_FEE=49
FREE_SHIPPING_THRESHOLD=999

# --- Email (verification, order updates) ----------------------------------
EMAIL_API_KEY=
EMAIL_FROM=no-reply@zyrexstore.example
